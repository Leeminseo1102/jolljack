<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="kopo.poly.jolljack.mapper.IWeatherMapper">

    <select id="getRegionId" parameterType="RegionGridDTO" resultType="Long">
        SELECT region_id
        FROM users
        WHERE user_id = #{userId}
            LIMIT 1
    </select>

    <select id="getRegionGrid" parameterType="RegionGridDTO" resultType="RegionGridDTO">
        SELECT NULL AS user_id,
               region_id,
               full_region_name AS region,
               nx,
               ny
        FROM region
        WHERE region_id = #{regionId}
            LIMIT 1
    </select>

</mapper>